{
  "name": "gov-tenders-mcp",
  "version": "0.2.0",
  "description": "Stdio MCP server for government tenders, grants, awards and council meetings via Apify's hosted MCP gateway",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gov-tenders-mcp": "src/server.js"
  },
  "main": "src/proxy.js",
  "files": [
    "src",
    "tools.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/env-guard.test.js test/proxy.test.js",
    "build:tools": "node scripts/build-tools.mjs",
    "check:tools": "node scripts/build-tools.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeminiGeorge22/gov-tenders-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "apify"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "mcpProxy": {
    "actors": [
      "publicrecords/govcon-opportunity-feed",
      "publicrecords/grants-gov-scraper",
      "publicrecords/usaspending-awards-scraper",
      "publicrecords/uk-find-a-tender-scraper",
      "publicrecords/eu-ted-notices-scraper",
      "publicrecords/legistar-meetings-scraper"
    ]
  }
}
